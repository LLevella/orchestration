# Run history is process output, not source. Never committed. (A project can move it
# out of the tool entirely with paths.runs_dir in its project layer.)
runs/

# Task working area, when a project keeps one here rather than beside itself.
tmp/

# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Stray process output
*.err
*.out
*.log

# Local secrets: API keys are read from the environment, never committed.
# deepseek.env / gemini.env are sourced from ~/.config/orchestration, not from here.
.env
*.env

# Local backups and model/CLI caches
*.bak
*cache*.json

# The per-project layer: which repos, where, and the domain context. Not reusable,
# so not tracked - usually a symlink to a project.json kept beside the project.
config/project.json
